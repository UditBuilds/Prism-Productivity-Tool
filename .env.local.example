# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Groq — https://console.groq.com/keys (free, no credit card)
GROQ_API_KEY=your_groq_api_key

# Public base URL of the deployed app — used for password-reset redirect links.
# Locally this can be omitted (falls back to window.location.origin).
NEXT_PUBLIC_APP_URL=https://your-vercel-url.vercel.app

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com
# Shared secret guarding /api/push/due (the cron endpoint). Generate any random string.
CRON_SECRET=a_random_secret_string_you_generate

# Supadata — https://supadata.ai (optional; powers YouTube → flashcards).
# Without it, the YouTube analyzer returns an honest "not configured" error.
SUPADATA_API_KEY=your_supadata_api_key

# Instagram publishing (Meta Graph API) — optional; the module is not wired to
# any UI or trigger yet. All four are required together: with any of them unset
# the module throws NOT_CONFIGURED naming exactly which ones are missing.
#   META_APP_ID / META_APP_SECRET — Meta app credentials. Both are needed
#     because GET /debug_token authenticates with an app access token
#     ("{app-id}|{app-secret}"), which is how token health is checked.
#   IG_BUSINESS_ACCOUNT_ID — the Instagram Business/Creator account id.
#   META_PAGE_ACCESS_TOKEN — a LONG-LIVED Page access token. Derive it from a
#     long-lived USER token (/me/accounts); one derived from a short-lived user
#     token expires in about an hour and looks fine until it doesn't.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
# Optional — pins the Graph API version (default v26.0, latest as of 2026-09-10).
# META_GRAPH_API_VERSION=v26.0
